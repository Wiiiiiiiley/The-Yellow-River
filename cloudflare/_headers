/experiments/observed_rivers/data/*.csv
  Content-Type: text/csv; charset=utf-8
  Content-Disposition: attachment

/experiments/observed_rivers/backtests/*.csv
  Content-Type: text/csv; charset=utf-8
  Content-Disposition: attachment

/experiments/observed_rivers/forecasts/*.csv
  Content-Type: text/csv; charset=utf-8
  Content-Disposition: attachment

/experiments/observed_rivers/transfer/*.csv
  Content-Type: text/csv; charset=utf-8
  Content-Disposition: attachment

/experiments/observed_rivers/raw/*.xlsx
  Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
  Content-Disposition: attachment

/LICENSE.observed-models
  Content-Type: text/plain; charset=utf-8
